# Copie para apps/web/.env.local (dev) e cadastre as mesmas chaves na Vercel.

# --- App
APP_URL=http://localhost:3000            # na Vercel: https://agente-gaucho.vercel.app
AUTH_SECRET=                             # openssl rand -hex 32
ADMIN_EMAILS=voce@exemplo.com            # e-mails que podem entrar no painel (vírgula)
CRON_SECRET=                             # openssl rand -hex 32 (Vercel Cron envia como Bearer)

# --- Banco (Neon, grátis) — pooled no DATABASE_URL, direta no DATABASE_URL_UNPOOLED
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Redis (Upstash, grátis) — aba REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- E-mail do login (Resend, grátis)
RESEND_API_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev  # remetente do Resend (NÃO é a lista de quem entra)
# Gmail (opcional, recomendado): se preenchido, substitui o Resend e entrega p/ qualquer e-mail
GMAIL_USER=
GMAIL_APP_PASSWORD=                      # myaccount.google.com/apppasswords (exige verificação em 2 etapas)

# --- IA: Gemini → Groq → Anthropic (nesta ordem de fallback)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=                       # opcional (pago)
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_WORKSPACE_ID=                  # só se a chave não pertencer a um workspace

# --- Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=               # openssl rand -hex 32 — colar também no painel da Meta
META_GRAPH_VERSION=v24.0

# --- Guardrails de custo (só a Anthropic gera custo)
COST_LIMIT_USD_PER_CONTACT_DAY=0.5
COST_LIMIT_USD_TOTAL_DAY=2

# --- Usados só pelo seed (valores iniciais; depois edite no painel)
DELIVERY_URL=
HANDOFF_PHONE=
