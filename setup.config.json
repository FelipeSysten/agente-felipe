{
  "$schema": "./setup.config.schema.json",
  "version": 2,
  "project": {
    "name": "agente-felipe",
    "slug": "agente-felipe",
    "repoPath": "C:/Users/Brendo/Documents/DEV/agent-felipe/agente-felipe",
    "createdAt": "2026-10-20T17:40:00-03:00"
  },
  "channels": {
    "enabled": [
      "waha_core"
    ],
    "waha_core": {
      "enabled": true,
      "session": "default",
      "engine": "BAILEYS_GATEWAY",
      "image": "devlikeapro/waha:latest",
      "hosting": "pc_local: infra/wa-gateway (Baileys, API compatível Waha) + Cloudflare Quick Tunnel com auto-registro"
    },
    "waha_plus": {
      "enabled": false,
      "session": "default",
      "engine": "GOWS",
      "image": "devlikeapro/waha-plus:latest"
    },
    "evolution_api": {
      "enabled": false,
      "image": "atendai/evolution-api:latest",
      "instanceName": "default",
      "port": 8080
    },
    "whatsapp_cloud": {
      "enabled": false,
      "phoneNumberId": null,
      "businessAccountId": null,
      "webhookVerifyToken": null
    },
    "instagram_direct": {
      "enabled": false,
      "igBusinessAccountId": null,
      "pageId": null
    }
  },
  "useCase": "freelancer_leads",
  "useCaseNotes": "Assistente no WhatsApp pessoal do Felipe (design, desenvolvimento e TI): qualifica interessados, envia o portfólio e encaminha pedidos de orçamento. Ignora conversas pessoais.",
  "language": "pt-BR",
  "volume": "low",
  "handoff": {
    "trigger": "explicit",
    "destination": "same_channel"
  },
  "llm": {
    "providers": [
      "google",
      "groq",
      "anthropic"
    ],
    "primary": "google",
    "defaultModel": "gemini-2.5-flash",
    "fallbackChain": [
      {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "tier": "free"
      },
      {
        "provider": "groq",
        "model": "openai/gpt-oss-120b",
        "tier": "free"
      },
      {
        "provider": "anthropic",
        "model": "claude-haiku-5-5",
        "tier": "paid",
        "optional": true
      }
    ],
    "fallbackPolicy": "provider",
    "memory": "window_20"
  },
  "tools": {
    "calendar": false,
    "webSearch": false,
    "rag": false,
    "webhook": false
  },
  "schedule": {
    "mode": "24_7",
    "timezone": "America/Sao_Paulo"
  },
  "cache": {
    "enabled": true,
    "provider": "upstash_redis",
    "debounce": {
      "enabled": true,
      "windowMs": 5000,
      "maxBufferedMessages": 20,
      "keyPrefix": "debounce",
      "runtime": "vercel_after"
    }
  },
  "infra": {
    "hosting": "vercel",
    "app": "vercel_hobby",
    "db": "neon_postgres",
    "auth": "magic_link_custom",
    "authEmailProvider": "resend",
    "domain": "vercel_subdomain",
    "customDomain": null,
    "costTarget": "zero",
    "waha": "pc_local_gateway"
  },
  "checkpoint": "deployed",
  "warnings": [
    "Vercel Hobby é só para uso não-comercial pelos termos da Vercel; com volume comercial, migrar para Pro.",
    "Cadeia de IA: Gemini (free) → Groq (free) → Anthropic (paga, só se as grátis falharem; opcional). Modelos validados via API no setup.",
    "Gemini free tier: o Google pode usar os dados das conversas para melhorar produtos.",
    "App na Vercel (serverless): debounce via after()/waitUntil em vez de setTimeout em processo longo.",
    "Waha usa o WhatsApp Web de forma não oficial: risco de bloqueio do número pela Meta em uso abusivo.",
    "Canal QR roda no PC do usuário: só responde com o PC ligado. Quick Tunnel da Cloudflare não tem SLA.",
    "Número pessoal no canal QR: risco de bloqueio do número pelo WhatsApp em uso abusivo; a Cloud API não serve porque tiraria o número do app."
  ]
}
